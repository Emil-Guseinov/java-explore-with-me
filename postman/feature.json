      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"firstCommentId\", pm.response.json().id);",
              "pm.test(\"Автор и событие берутся из пути\", () => { const c = pm.response.json(); pm.expect(c.author.id).to.eql(Number(pm.collectionVariables.get(\"authorId\"))); pm.expect(c.event).to.eql(Number(pm.collectionVariables.get(\"eventId\"))); pm.expect(c.author).not.to.have.property(\"email\"); });",
              "pm.test(\"Текст и время создания\", () => { const c = pm.response.json(); pm.expect(c.text).to.eql(\"Где встречаемся?\"); pm.expect(c.created).to.match(/^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$/); pm.expect(c.created).not.to.eql(\"2000-01-01 00:00:00\"); pm.expect(c.updated).to.eql(null); });",
              "pm.collectionVariables.set(\"firstCreated\", pm.response.json().created);"
            ]
          }
        }
      ]
    },
