{
  "info": {
    "name": "ExploreWithMe — комментарии к событиям",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Создать организатора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/users",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Организатор\", \"email\": \"organizer-{{suffix}}@example.org\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"suffix\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"futureDate\", new Date(Date.now() + 172800000).toISOString().slice(0, 19).replace(\"T\", \" \"));",
              "pm.collectionVariables.set(\"missingId\", \"9223372036854775807\");",
              "pm.collectionVariables.set(\"longText\", \"а\".repeat(2001));",
              "pm.collectionVariables.set(\"maxText\", \"а\".repeat(2000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"organizerId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
