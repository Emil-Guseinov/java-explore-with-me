          }
        ],
        "url": "{{baseUrl}}/users/{{authorId}}/events/{{eventId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Где встречаемся?\", \"author\": {\"id\": \"{{otherUserId}}\"}, \"event\": \"{{otherEventId}}\", \"created\": \"2000-01-01 00:00:00\"}",
          "options": {
            "raw": {
              "language": "json"
